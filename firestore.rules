rules_version = '2';
// The same file is in every Linguae repository (verba, palabras, mots, woerter, linguae, vocabula); publish it in the Firebase
// console for project verba-791ca after changing it, and copy it to all of them.
// Verba accounts: each account is one document named by its secret account key.
// A key can read and save its own document; nobody can list or delete accounts.
//
// Leaderboard: board/{id} is public. The id is a hash of the account key, so it never reveals the key.
// Each update must include `prev`, the link of a hash chain (made from the account key) whose SHA-256
// equals the stored `lock`, and must set a new lock. Only someone holding the account key can make the
// next link, so only the owner can change their entry. XP can only rise at a realistic speed.
//
// Usernames: handles/{name} says which board entry owns a username. A board entry can only use a
// username whose handles document points back at it, and a handles document can only be created in
// the same write that points its owner's entry at it, so no two students can share a username.
//
// Spanish leaderboard: boardes/{id} is the public board of Palabras, Verba's Spanish sister site. Same rules as
// board/{id}, with the same id (so one username serves both sites) and Spanish course codes. A username belongs to an
// account while either of its boards points at it.
//
// French leaderboard: boardfr/{id} is the public board of Mots, the French sister site, with the same rules and ids as
// boardes/{id}. A username belongs to an account while any of its boards points at it.
//
// German leaderboard: boardde/{id} is the public board of Wörter, the German sister site, with the same rules and ids as
// boardes/{id}.
//
// Vocab progress: vocab/{id} holds Vocābula's flashcard progress for one account, named by the same secret account
// key as accounts/{id}. It can only be saved for an account that exists. No leaderboard; nobody can list or delete them.
//
// Password logins (optional): logins/{id} holds the account key, encrypted in the browser with a key stretched from
// the username and password. The id comes from the same stretching, so it reveals neither. No password is ever
// stored in readable form, and no email is ever asked for or sent. Each change must show the previous link of a hash
// chain made from the account key, so only someone logged in to that account can change or switch off its login.
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{id} {
      allow get: if id.size() == 24;
      allow create, update: if id.size() == 24
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 60000;
      allow list, delete: if false;
    }

    match /vocab/{id} {
      allow get: if id.size() == 24;
      allow create, update: if id.size() == 24
        && exists(/databases/$(database)/documents/accounts/$(id))
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000;
      allow list, delete: if false;
    }

    function boardOk(pid, d, courses) {
      let fields = ['n', 'lock', 'prev', 'on', 'xp', 'wk', 'wxp', 'days', 'dlast', 'best', 'since',
                    'disp', 'handle', 'hid', 'name', 'nvis', 'school', 'course',
                    'pic', 'img', 'bio', 'motto', 'banner', 't'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.n is int && d.lock is bytes && d.lock.size() == 32
        && d.prev is string && d.prev.size() <= 64
        && d.on is bool
        && d.xp is int && d.xp >= 0
        && d.wk is string && d.wk.size() <= 10
        && d.wxp is int && d.wxp >= 0 && d.wxp <= d.xp
        && d.days is int && d.days >= 0 && d.days <= 5000
        && d.best is int && d.best >= 0 && d.best <= 5000
        && d.dlast is string && d.dlast.size() <= 10
        && d.since is string && d.since.size() <= 10
        && d.disp is string && d.disp.size() <= 24
        && d.handle is string && d.handle.size() <= 20
        && d.hid is string && d.hid.matches('([a-z0-9_]{3,20})?')
        && (d.hid == '' || (existsAfter(/databases/$(database)/documents/handles/$(d.hid))
            && getAfter(/databases/$(database)/documents/handles/$(d.hid)).data.owner == pid))
        && d.name is string && d.name.size() <= 51
        && d.nvis in ['', 'school', 'all']
        && d.school is string && d.school.size() <= 60
        && d.course in courses
        && d.pic is string && d.pic.matches('(p:[a-z0-9-]{1,24}|u:[0-9a-f]{8})?')
        && d.img is string && d.img.size() <= 15000
        && (d.img == '' || d.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && d.bio is string && d.bio.size() <= 200
        && d.motto is string && d.motto.size() <= 80
        && d.banner is string && d.banner.matches('(c:[a-z]{2,10}|p:[a-z0-9-]{1,24})?')
        && d.t == request.time;
    }
    match /board/{pid} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if pid.matches('[0-9a-f]{24}')
        && boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'AP', 'AP+'])
        && request.resource.data.n == 0
        && request.resource.data.prev == ''
        && request.resource.data.xp <= 100000;
      allow update: if boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'AP', 'AP+'])
        && request.resource.data.n == resource.data.n + 1
        && hashing.sha256(request.resource.data.prev) == resource.data.lock
        && request.resource.data.xp <= resource.data.xp + 1000
             + (request.time.toMillis() - resource.data.t.toMillis()) / 100;
      allow delete: if false;
    }
    match /boardes/{pid} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if pid.matches('[0-9a-f]{24}')
        && boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == 0
        && request.resource.data.prev == ''
        && request.resource.data.xp <= 100000;
      allow update: if boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == resource.data.n + 1
        && hashing.sha256(request.resource.data.prev) == resource.data.lock
        && request.resource.data.xp <= resource.data.xp + 1000
             + (request.time.toMillis() - resource.data.t.toMillis()) / 100;
      allow delete: if false;
    }
    match /boardfr/{pid} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if pid.matches('[0-9a-f]{24}')
        && boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == 0
        && request.resource.data.prev == ''
        && request.resource.data.xp <= 100000;
      allow update: if boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == resource.data.n + 1
        && hashing.sha256(request.resource.data.prev) == resource.data.lock
        && request.resource.data.xp <= resource.data.xp + 1000
             + (request.time.toMillis() - resource.data.t.toMillis()) / 100;
      allow delete: if false;
    }
    match /boardde/{pid} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if pid.matches('[0-9a-f]{24}')
        && boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == 0
        && request.resource.data.prev == ''
        && request.resource.data.xp <= 100000;
      allow update: if boardOk(pid, request.resource.data, ['', 'I', 'I+', 'II', 'II+', 'III', 'III+', 'IV', 'IV+', 'AP', 'AP+'])
        && request.resource.data.n == resource.data.n + 1
        && hashing.sha256(request.resource.data.prev) == resource.data.lock
        && request.resource.data.xp <= resource.data.xp + 1000
             + (request.time.toMillis() - resource.data.t.toMillis()) / 100;
      allow delete: if false;
    }
    function points(owner, hid) {
      return (existsAfter(/databases/$(database)/documents/board/$(owner))
                && getAfter(/databases/$(database)/documents/board/$(owner)).data.hid == hid)
          || (existsAfter(/databases/$(database)/documents/boardes/$(owner))
                && getAfter(/databases/$(database)/documents/boardes/$(owner)).data.hid == hid)
          || (existsAfter(/databases/$(database)/documents/boardfr/$(owner))
                && getAfter(/databases/$(database)/documents/boardfr/$(owner)).data.hid == hid)
          || (existsAfter(/databases/$(database)/documents/boardde/$(owner))
                && getAfter(/databases/$(database)/documents/boardde/$(owner)).data.hid == hid);
    }
    match /handles/{hid} {
      allow get: if true;
      allow list: if false;
      allow create: if hid.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['owner'])
        && request.resource.data.owner is string
        && points(request.resource.data.owner, hid);
      allow delete: if !points(resource.data.owner, hid);
      allow update: if false;
    }

    function loginOk(d) {
      return d.keys().hasOnly(['v', 'iv', 'ct', 'gate', 'n', 'prev', 't'])
        && d.keys().hasAll(['v', 'iv', 'ct', 'gate', 'n', 'prev', 't'])
        && d.v == 1
        && d.iv is string && d.iv.size() <= 24
        && d.ct is string && d.ct.size() <= 200
        && d.gate is bytes && d.gate.size() == 32
        && d.n is int && d.prev is string && d.prev.size() <= 64
        && d.t == request.time;
    }
    match /logins/{id} {
      allow get: if id.matches('[0-9a-f]{32}');
      allow list, delete: if false;
      allow create: if id.matches('[0-9a-f]{32}')
        && loginOk(request.resource.data)
        && request.resource.data.n == 0
        && request.resource.data.prev == ''
        && request.resource.data.ct.size() > 0;
      allow update: if loginOk(request.resource.data)
        && request.resource.data.n == resource.data.n + 1
        && hashing.sha256(request.resource.data.prev) == resource.data.gate;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
